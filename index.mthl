<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alex's November Revision Hub</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#F7F4EF;--surface:#fff;--ink:#1A1714;--ink2:#5A5450;--ink3:#9A9490;
  --accent:#2B5E8A;--border:rgba(26,23,20,0.10);
  --math-bg:#EBF3FB;--math-t:#174F82;
  --eng-bg:#EEF5E8;--eng-t:#2B5A1A;
  --sci-bg:#E8F4F0;--sci-t:#165A48;
  --span-bg:#FDF3E4;--span-t:#7A4A0A;
  --pe-bg:#FDE9E4;--pe-t:#7A2A14;
  --biz-bg:#F0EBF8;--biz-t:#4A1E7A;
  --fd:'Fraunces',Georgia,serif;
  --fb:'DM Sans',system-ui,sans-serif;
  --r:12px;
}
html{scroll-behavior:smooth}
body{font-family:var(--fb);background:var(--bg);color:var(--ink);font-size:15px;line-height:1.6;min-height:100vh}
nav{background:var(--ink);color:#fff;padding:0 2rem;display:flex;align-items:center;position:sticky;top:0;z-index:100;overflow-x:auto;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
.nav-brand{font-family:var(--fd);font-size:16px;font-weight:600;color:#fff;white-space:nowrap;padding:14px 0;margin-right:20px;flex-shrink:0}
.nav-brand span{color:#69B3E7;font-style:italic}
nav button{background:none;border:none;color:rgba(255,255,255,0.6);font-family:var(--fb);font-size:13px;font-weight:500;padding:14px 12px;cursor:pointer;white-space:nowrap;flex-shrink:0;border-bottom:2px solid transparent;transition:color .2s,border-color .2s}
nav button:hover{color:#fff}
nav button.active{color:#fff;border-bottom-color:#69B3E7}
main{max-width:900px;margin:0 auto;padding:2rem 1.5rem 4rem}
.page{display:none}
.page.active{display:block}
.hero{display:flex;align-items:center;gap:1.75rem;padding:2rem 0 1.75rem;flex-wrap:wrap}
.hero-photo{width:160px;height:176px;border-radius:16px;object-fit:cover;object-position:center 20%;border:3px solid #69B3E7;flex-shrink:0;box-shadow:0 4px 20px rgba(43,94,138,0.25)}
.hero-text h1{font-family:var(--fd);font-size:clamp(1.6rem,4vw,2.4rem);font-weight:700;line-height:1.15;margin-bottom:.5rem}
.hero-text h1 em{color:var(--accent);font-style:italic}
.hero-text p{color:var(--ink2);font-size:15px;max-width:460px;margin-bottom:1rem}
.countdown-strip{display:inline-flex;gap:10px;background:var(--ink);color:#fff;border-radius:40px;padding:9px 18px;font-size:13px;font-weight:500;align-items:center}
.countdown-strip .days{font-family:var(--fd);font-size:20px;font-weight:700;color:#69B3E7}
.how-to{background:linear-gradient(135deg,#EBF3FB,#E8F4F0);border:1px solid rgba(43,94,138,0.15);border-radius:var(--r);padding:1rem 1.25rem;margin:1rem 0 0}
.how-to h4{font-size:13px;font-weight:600;color:var(--accent);margin-bottom:8px}
.how-to-steps{display:flex;gap:10px;flex-wrap:wrap}
.how-step{font-size:12px;color:var(--ink2);background:#fff;border-radius:8px;padding:7px 11px;display:flex;align-items:center;gap:7px;border:1px solid var(--border)}
.how-step .num{background:var(--accent);color:#fff;width:18px;height:18px;border-radius:50%;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.subject-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-top:1.75rem}
.subj-card{border-radius:var(--r);padding:1.1rem 1.2rem;cursor:pointer;transition:transform .18s,box-shadow .18s}
.subj-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,0.10)}
.subj-card .emoji{font-size:22px;margin-bottom:7px;display:block}
.subj-card h3{font-size:14px;font-weight:600;margin-bottom:3px}
.subj-card p{font-size:12px;opacity:.75;line-height:1.4}
.golden-rules{margin-top:1.75rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1.25rem 1.5rem}
.golden-rules h4{font-family:var(--fd);font-size:1.05rem;font-weight:700;margin-bottom:.75rem}
.rules-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(195px,1fr));gap:8px}
.rule{font-size:13px;color:var(--ink2);background:var(--bg);border-radius:8px;padding:10px 12px;line-height:1.5}
.rule strong{color:var(--ink);display:block;margin-bottom:2px}
.section-title{font-family:var(--fd);font-size:1.6rem;font-weight:700;margin-bottom:.3rem}
.section-sub{color:var(--ink2);font-size:14px;margin-bottom:1.5rem}
.week-tabs{display:flex;gap:6px;margin-bottom:1.25rem;flex-wrap:wrap}
.wtab{padding:7px 16px;border-radius:30px;border:1.5px solid var(--border);background:var(--surface);font-family:var(--fb);font-size:13px;font-weight:500;cursor:pointer;color:var(--ink2);transition:all .18s}
.wtab:hover{border-color:var(--accent);color:var(--accent)}
.wtab.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.week-note{background:var(--surface);border-left:3px solid var(--accent);border-radius:0 var(--r) var(--r) 0;padding:10px 14px;font-size:13px;color:var(--ink2);margin-bottom:1.25rem}
.sessions-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:10px}
.session-card{border-radius:var(--r);padding:1rem 1.1rem}
.session-card.day-off{background:var(--bg);border:1.5px dashed var(--border);color:var(--ink2)}
.s-day{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px;opacity:.7}
.s-subj{font-size:15px;font-weight:600;margin-bottom:4px}
.s-detail{font-size:12px;line-height:1.55;opacity:.85}
.s-dur{font-size:11px;margin-top:8px;opacity:.65;font-weight:500}
.s-links{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
.s-link{font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;text-decoration:none;border:1px solid currentColor;opacity:.85;transition:opacity .15s;display:inline-block}
.s-link:hover{opacity:1}
.subject-header{border-radius:var(--r);padding:1.75rem 2rem;margin-bottom:1.75rem}
.subject-header h2{font-family:var(--fd);font-size:2rem;font-weight:700;margin-bottom:.25rem}
.board-tag{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;opacity:.65;margin-bottom:8px}
.subject-header p{font-size:14px;opacity:.82;line-height:1.55}
.resource-section{margin-bottom:2rem}
.resource-section h3{font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-bottom:10px;display:flex;align-items:center;gap:8px}
.resource-section h3::after{content:'';flex:1;height:1px;background:var(--border)}
.link-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px}
.link-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:.9rem 1rem;text-decoration:none;color:inherit;transition:border-color .18s,transform .18s,box-shadow .18s;display:flex;flex-direction:column;gap:4px}
.link-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,0.07)}
.lc-badge{font-size:10px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:2px 8px;border-radius:20px;display:inline-block;width:fit-content;margin-bottom:2px}
.lc-name{font-size:14px;font-weight:600}
.lc-desc{font-size:12px;color:var(--ink2);line-height:1.4}
.free-note{font-size:11px;color:#2B5A1A;background:#EEF5E8;border-radius:20px;padding:2px 8px;display:inline-block;margin-top:4px}
.tips-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px}
.tip-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:.9rem 1rem .9rem 2.2rem;font-size:13px;color:var(--ink2);line-height:1.55;position:relative}
.tip-card::before{content:attr(data-n);position:absolute;left:.85rem;top:.9rem;font-size:12px;font-weight:700;color:var(--ink3)}
.tiktok-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
.tt-chip{display:inline-flex;align-items:center;gap:7px;background:#010101;color:#fff;border-radius:30px;padding:7px 14px;font-size:13px;font-weight:500;text-decoration:none;transition:opacity .18s}
.tt-chip:hover{opacity:.75}
.tt-icon{width:16px;height:16px;background:linear-gradient(135deg,#ff0050,#69C9D0);border-radius:4px;flex-shrink:0}
.tt-desc-row{font-size:12px;color:var(--ink2);line-height:1.6}
.back-btn{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--ink2);cursor:pointer;margin-bottom:1.5rem;background:none;border:none;font-family:var(--fb);padding:0;transition:color .18s}
.back-btn:hover{color:var(--accent)}
.timer-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:1rem 1.1rem;min-width:200px;max-width:240px;flex-shrink:0}
.t-label{font-size:11px;font-weight:600;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}
.t-progress{width:100%;height:5px;background:var(--bg);border-radius:3px;overflow:hidden;margin-bottom:8px}
.t-bar{height:100%;background:var(--accent);border-radius:3px;transition:width .5s linear,background .3s;width:100%}
.t-display{font-family:var(--fd);font-size:2.5rem;font-weight:700;text-align:center;color:var(--accent);line-height:1;margin-bottom:.75rem;transition:color .3s}
.t-display.warn{color:#D4521C}
.t-display.done{color:#2B5A1A}
.t-presets{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:.6rem}
.t-preset{padding:4px 8px;border-radius:20px;border:1.5px solid var(--border);background:var(--bg);font-family:var(--fb);font-size:12px;font-weight:500;cursor:pointer;color:var(--ink2);transition:all .18s}
.t-preset:hover{border-color:var(--accent);color:var(--accent)}
.t-preset.sel{background:var(--accent);color:#fff;border-color:var(--accent)}
.t-custom{display:flex;align-items:center;gap:6px;margin-bottom:.6rem}
.t-custom input{width:55px;padding:5px 8px;border:1.5px solid var(--border);border-radius:8px;font-family:var(--fb);font-size:13px;font-weight:600;text-align:center;background:var(--bg);color:var(--ink)}
.t-custom input:focus{outline:none;border-color:var(--accent)}
.t-controls{display:flex;gap:6px;margin-bottom:.5rem}
.t-btn{padding:7px 10px;border-radius:30px;border:none;font-family:var(--fb);font-size:13px;font-weight:600;cursor:pointer;transition:all .18s}
.t-btn.go{background:var(--accent);color:#fff;flex:1}
.t-btn.go:hover{opacity:.85}
.t-btn.pause{background:var(--bg);color:var(--ink);border:1.5px solid var(--border);flex:1}
.t-btn.rst{background:var(--bg);color:var(--ink2);border:1.5px solid var(--border);padding:7px 10px}
.t-msg{font-size:11px;color:var(--ink2);text-align:center;min-height:16px}
@media(max-width:600px){nav{padding:0 1rem}main{padding:1.5rem 1rem 3rem}.hero{gap:1rem}.hero-photo{width:120px;height:132px}.timer-box{max-width:100%;width:100%}}

  .today-panel{background:var(--surface);border:2px solid var(--accent);border-radius:var(--r);padding:1.25rem 1.5rem;margin-top:1.5rem}
  .today-panel .today-label{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:6px}
  .today-panel .today-date{font-size:13px;color:var(--ink2);margin-bottom:10px}
  .today-panel .today-subj{font-family:var(--fd);font-size:1.4rem;font-weight:700;color:var(--ink);margin-bottom:4px}
  .today-panel .today-detail{font-size:13px;color:var(--ink2);line-height:1.55;margin-bottom:10px}
  .today-panel .today-links{display:flex;flex-wrap:wrap;gap:6px}
  .today-panel .today-link{font-size:12px;font-weight:600;padding:4px 12px;border-radius:20px;text-decoration:none;background:var(--accent);color:#fff;transition:opacity .18s}
  .today-panel .today-link:hover{opacity:.85}
  .today-panel .today-off{font-family:var(--fd);font-size:1.2rem;font-weight:600;color:var(--ink2)}

</style>
</head>
<body>
<nav>
  <div class="nav-brand">Alex's <span>Nov Mocks</span></div>
  <button class="active" onclick="showPage('home')">&#127968; Home</button>
  <button onclick="showPage('timetable')">&#128197; Timetable</button>
  <button onclick="showSubject('math')">&#128208; Maths</button>
  <button onclick="showSubject('english')">&#128214; English</button>
  <button onclick="showSubject('science')">&#128300; Science</button>
  <button onclick="showSubject('spanish')">&#127758; Spanish</button>
  <button onclick="showSubject('pe')">&#127939; PE</button>
  <button onclick="showSubject('business')">&#128188; Business</button>
</nav>
<main>

<div class="page active" id="page-home">
  <div class="hero">
    <div class="timer-box">
      <div class="t-label">&#9203; Session Timer</div>
      <div class="t-progress"><div class="t-bar" id="t-bar"></div></div>
      <div class="t-display" id="t-disp">20:00</div>
      <div class="t-presets">
        <button class="t-preset sel" onclick="tPreset(20)">20m</button>
        <button class="t-preset" onclick="tPreset(25)">25m</button>
        <button class="t-preset" onclick="tPreset(30)">30m</button>
        <button class="t-preset" onclick="tPreset(40)">40m</button>
        <button class="t-preset" onclick="tPreset(55)">55m</button>
      </div>
      <div class="t-custom">
        <input type="number" id="t-custom" min="1" max="120" value="20" onchange="tCustom(this.value)">
        <span style="font-size:12px;color:var(--ink2)">custom mins</span>
      </div>
      <div class="t-controls">
        <button class="t-btn go" id="t-go" onclick="tGo()">&#9654; Start</button>
        <button class="t-btn rst" onclick="tReset()">&#8634;</button>
      </div>
      <div class="t-msg" id="t-msg">Set time and press Start!</div>
    </div>
    <img class="hero-photo" src="data:image/jpeg;base64," alt="Alex">
    <div class="hero-text">
      <h1>Alex's November<br><em>Mock Revision</em></h1>
      <p>Your personalised revision plan. Short sessions done consistently make a massive difference. Mocks start 16th November.</p>
      <div class="countdown-strip">
        <span>&#9203;</span>
        <span class="days" id="cd-days">--</span>
        <span id="cd-lbl">days to go</span>
      </div>
    </div>
  </div>

  <div class="how-to">
    <h4>&#128203; How to use this hub</h4>
    <div class="how-to-steps">
      <div class="how-step"><div class="num">1</div>Check the <strong>Timetable</strong> to see today's session</div>
      <div class="how-step"><div class="num">2</div>Click a <strong>subject</strong> card to find links and tips</div>
      <div class="how-step"><div class="num">3</div>Set the timer, do the session, done!</div>
    </div>
  </div>

  <div class="today-panel" id="today-panel">
    <div class="today-label">&#128197; Today's Revision Session</div>
    <div class="today-date" id="today-date"></div>
    <div class="today-subj" id="today-subj">Loading...</div>
    <div class="today-detail" id="today-detail"></div>
    <div class="today-links" id="today-links"></div>
  </div>

  <div class="subject-grid">
    <div class="subj-card" style="background:var(--math-bg);color:var(--math-t)" onclick="showSubject('math')"><span class="emoji">&#128208;</span><h3>Maths Higher</h3><p>AQA &middot; Corbettmaths &middot; Dr Frost</p></div>
    <div class="subj-card" style="background:var(--eng-bg);color:var(--eng-t)" onclick="showSubject('english')"><span class="emoji">&#128214;</span><h3>English Lit &amp; Lang</h3><p>AQA &middot; Mr Bruff &middot; Tassomai</p></div>
    <div class="subj-card" style="background:var(--sci-bg);color:var(--sci-t)" onclick="showSubject('science')"><span class="emoji">&#128300;</span><h3>Combined Science</h3><p>AQA Foundation &middot; Sparx</p></div>
    <div class="subj-card" style="background:var(--span-bg);color:var(--span-t)" onclick="showSubject('spanish')"><span class="emoji">&#127758;</span><h3>Spanish</h3><p>AQA &middot; Seneca &middot; Quizlet</p></div>
    <div class="subj-card" style="background:var(--pe-bg);color:var(--pe-t)" onclick="showSubject('pe')"><span class="emoji">&#127939;</span><h3>PE Theory</h3><p>AQA &middot; Seneca &middot; BBC Bitesize</p></div>
    <div class="subj-card" style="background:var(--biz-bg);color:var(--biz-t)" onclick="showSubject('business')"><span class="emoji">&#128188;</span><h3>Business BTEC</h3><p>BTEC &middot; Tutor2u &middot; Key terms</p></div>
  </div>

  <div class="golden-rules">
    <h4>&#129504; Golden rules</h4>
    <div class="rules-grid">
      <div class="rule"><strong>Short sessions work.</strong>20-55 mins of focused revision beats a 3-hour grind every time.</div>
      <div class="rule"><strong>Active beats passive.</strong>Seneca and past papers beat re-reading notes. Always.</div>
      <div class="rule"><strong>Set a timer.</strong>Work until it goes off. Short break. Repeat.</div>
      <div class="rule"><strong>Fridays are yours.</strong>One day off a week is part of the plan.</div>
    </div>
  </div>
</div>

<div class="page" id="page-timetable">
  <div class="section-title">Revision Timetable</div>
  <div class="section-sub">6 weeks &middot; builds from 20 mins to 55 mins per day &middot; Fridays off &middot; Exams 16-26 November</div>
  <div class="week-tabs" id="wtabs"></div>
  <div class="week-note" id="wnote"></div>
  <div class="sessions-grid" id="sgrid"></div>
</div>

<div class="page" id="page-subject">
  <button class="back-btn" onclick="showPage('home')">&#8592; Back to subjects</button>
  <div id="subj-content"></div>
</div>

</main>
<script>
// COUNTDOWN
(function(){
  var d = new Date('2026-11-16');
  var now = new Date(); now.setHours(0,0,0,0);
  var diff = Math.ceil((d - now)/(864e5));
  var el = document.getElementById('cd-days');
  var lb = document.getElementById('cd-lbl');
  if(diff > 0){ el.textContent = diff; lb.textContent = diff===1?'day to go!':'days to go'; }
  else if(diff===0){ el.textContent='GO!'; lb.textContent='Exam day - good luck Alex!'; }
  else{ el.textContent='Done!'; lb.textContent='Mocks complete!'; }
})();

// NAV
var SNI = {math:2,english:3,science:4,spanish:5,pe:6,business:7};
function showPage(id){
  var ps=document.querySelectorAll('.page');
  for(var i=0;i<ps.length;i++) ps[i].classList.remove('active');
  document.getElementById('page-'+id).classList.add('active');
  var bs=document.querySelectorAll('nav button');
  for(var i=0;i<bs.length;i++) bs[i].classList.remove('active');
  if(id==='home') bs[0].classList.add('active');
  if(id==='timetable') bs[1].classList.add('active');
  window.scrollTo(0,0);
}
function showSubject(id){
  var ps=document.querySelectorAll('.page');
  for(var i=0;i<ps.length;i++) ps[i].classList.remove('active');
  document.getElementById('page-subject').classList.add('active');
  document.getElementById('subj-content').innerHTML=buildSubject(id);
  var bs=document.querySelectorAll('nav button');
  for(var i=0;i<bs.length;i++) bs[i].classList.remove('active');
  if(SNI[id]!==undefined) bs[SNI[id]].classList.add('active');
  window.scrollTo(0,0);
}

// TIMER
var tSecs=1200,tTotal=1200,tInterval=null,tRunning=false;
function tFmt(s){var m=Math.floor(s/60),x=s%60;return(m<10?'0':'')+m+':'+(x<10?'0':'')+x;}
function tUpdate(){
  var el=document.getElementById('t-disp'),bar=document.getElementById('t-bar'),msg=document.getElementById('t-msg');
  if(!el)return;
  el.textContent=tFmt(tSecs);
  var pct=tTotal>0?(tSecs/tTotal)*100:100;
  bar.style.width=pct+'%';
  if(tSecs<=0){el.className='t-display done';bar.style.background='#2B5A1A';msg.textContent='Session complete! Great work - take a break.';}
  else if(tSecs<=60){el.className='t-display warn';bar.style.background='#D4521C';msg.textContent='Less than a minute to go!';}
  else if(tSecs<=300){el.className='t-display warn';bar.style.background='#D4521C';msg.textContent='Nearly there - keep going!';}
  else{el.className='t-display';bar.style.background='var(--accent)';if(tRunning)msg.textContent='Session in progress - stay focused!';}
}
function tPreset(m){
  if(tRunning)return;
  tSecs=m*60;tTotal=m*60;
  document.getElementById('t-custom').value=m;
  var ps=document.querySelectorAll('.t-preset');
  for(var i=0;i<ps.length;i++){ps[i].classList.remove('sel');if(ps[i].textContent===m+'m')ps[i].classList.add('sel');}
  document.getElementById('t-msg').textContent='Set to '+m+' minutes. Press Start!';
  tUpdate();
}
function tCustom(v){
  if(tRunning)return;
  var m=parseInt(v); if(isNaN(m)||m<1)m=1; if(m>120)m=120;
  tSecs=m*60;tTotal=m*60;
  var ps=document.querySelectorAll('.t-preset');
  for(var i=0;i<ps.length;i++) ps[i].classList.remove('sel');
  document.getElementById('t-msg').textContent='Set to '+m+' minutes. Press Start!';
  tUpdate();
}
function tGo(){
  var btn=document.getElementById('t-go');
  if(tSecs<=0)return;
  if(tRunning){
    clearInterval(tInterval);tRunning=false;
    btn.textContent='&#9654; Resume';btn.className='t-btn go';
    document.getElementById('t-msg').textContent='Paused - press Resume when ready.';
  } else {
    tRunning=true;btn.textContent='&#9646;&#9646; Pause';btn.className='t-btn pause';
    document.getElementById('t-msg').textContent='Session in progress - stay focused!';
    tInterval=setInterval(function(){
      tSecs--;tUpdate();
      if(tSecs<=0){
        clearInterval(tInterval);tRunning=false;
        btn.textContent='&#9654; Start';btn.className='t-btn go';
        try{var c=new(window.AudioContext||window.webkitAudioContext)();var o=c.createOscillator();var g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=880;g.gain.setValueAtTime(0.3,c.currentTime);g.gain.exponentialRampToValueAtTime(0.001,c.currentTime+1.5);o.start(c.currentTime);o.stop(c.currentTime+1.5);}catch(e){}
      }
    },1000);
  }
}
function tReset(){
  clearInterval(tInterval);tRunning=false;tSecs=tTotal;
  var btn=document.getElementById('t-go');btn.textContent='&#9654; Start';btn.className='t-btn go';
  document.getElementById('t-msg').textContent='Timer reset. Press Start when ready!';
  tUpdate();
}
tUpdate();

