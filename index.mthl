  // Build lookup
  for(var wi=0;wi<allWeeks.length;wi++){
    var wk=allWeeks[wi];
    for(var si=0;si<wk.sessions.length;si++){
      var sess=wk.sessions[si];
      var key=wk.y+'-'+wk.m+'-'+sess.d;
      lookup[key]=sess.s;
    }
  }

  var key=yy+'-'+mm+'-'+dd;
  var today=lookup[key];
  var panel=document.getElementById('today-panel');
  var SC2={math:'var(--math-bg)',english:'var(--eng-bg)',science:'var(--sci-bg)',spanish:'var(--span-bg)',pe:'var(--pe-bg)',business:'var(--biz-bg)',off:'var(--bg)'};
  var TC2={math:'var(--math-t)',english:'var(--eng-t)',science:'var(--sci-t)',spanish:'var(--span-t)',pe:'var(--pe-t)',business:'var(--biz-t)',off:'var(--ink2)'};

  if(today){
    var bg=SC2[today.c]||'var(--bg)';
    var tc=TC2[today.c]||'var(--ink2)';
    panel.style.borderColor=tc;
    document.getElementById('today-subj').textContent=today.subj;
    document.getElementById('today-subj').style.color=tc;
    document.getElementById('today-detail').textContent=today.detail;
    var lh='';
