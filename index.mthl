var aw=0;
function renderTT(){
  var th='';
  for(var i=0;i<weeks.length;i++) th+='<button class="wtab'+(i===aw?' active':'')+'" onclick="setW('+i+')">'+weeks[i].label+'</button>';
  document.getElementById('wtabs').innerHTML=th;
  document.getElementById('wnote').innerHTML=weeks[aw].note;
  var sh='';
  for(var i=0;i<weeks[aw].sessions.length;i++){
    var s=weeks[aw].sessions[i];
    var off=s.c==='off';
    var bg=off?'':('background:'+SC[s.c].bg+';color:'+SC[s.c].t+';');
    var lh='';
    if(s.links&&s.links.length){
      lh='<div class="s-links">';
      for(var j=0;j<s.links.length;j++){
        var col=off?'var(--ink2)':SC[s.c].t;
        lh+='<a class="s-link" href="'+s.links[j].u+'" target="_blank" style="color:'+col+';border-color:'+col+'">'+s.links[j].l+' &rarr;</a>';
      }
      lh+='</div>';
    }
    sh+='<div class="session-card'+(off?' day-off':'')+'" style="'+bg+'">';
    sh+='<div class="s-day">'+s.day+'</div>';
    sh+='<div class="s-subj">'+s.subj+'</div>';
    sh+='<div class="s-detail">'+s.detail+'</div>';
    if(s.dur) sh+='<div class="s-dur">&#9203; '+s.dur+'</div>';
    sh+=lh+'</div>';
  }
  document.getElementById('sgrid').innerHTML=sh;
}
function setW(i){aw=i;renderTT();}
renderTT();

