    youtube:[{n:'Mr Bruff',u:'https://www.youtube.com/@mrbruff',d:'Model answers, essay walkthroughs, exam technique - legendary channel'},{n:'The English Teacher',u:'https://www.tiktok.com/@theenglishteacher',d:'Quick technique tips and hitting top marks'}],
    tiktoks:[{h:'@mrbruff',u:'https://www.tiktok.com/@mrbruff',d:'Short sharp English tips - yes he is on TikTok too'},{h:'@theenglishteacher',u:'https://www.tiktok.com/@theenglishteacher',d:'Language techniques and creative writing shortcuts'},{h:'#gcsemrbruff',u:'https://www.tiktok.com/tag/gcsemrbruff',d:'Community sharing tips and model answers'}],
    tips:['For Language Paper 1, spend 15 mins reading and annotating before writing a single word.','Learn your language techniques cold: sibilance, anaphora, enjambment, pathetic fallacy.','For Literature: point, evidence, explain, effect. Always comment on the writers deliberate choice.','An Inspector Calls and your Shakespeare text will both come up - know key quotes for major themes.','For Language Paper 2, always compare HOW writers present ideas - not just WHAT they say.']},
  science:{name:'Combined Science Trilogy',emoji:'&#128300;',board:'AQA Trilogy 8464 - Foundation Tier',bg:'var(--sci-bg)',t:'var(--sci-t)',
    blurb:'Combined Science Foundation tier, course code 8464. Covers Biology, Chemistry and Physics. Sparx Science is the school primary revision tool - use it every week.',
    websites:[{n:'Sparx Science',u:'https://www.sparxscience.com',d:'School tool - Independent Learning tab, select AQA GCSE, Biology 4.1-4.4, Chemistry 4.1-4.5, Physics 4.1-4.4',b:'School tool',f:true},{n:'FreeScienceLessons',u:'https://www.youtube.com/@Freesciencelessons',d:'AQA-specific videos for every topic - Shaun Donnelly is excellent and free',b:'Top pick',f:true},{n:'Oxford Revise Answers',u:'https://global.oup.com/education/content/secondary/key-issues/oxford-revise-science/answers/?region=uk',d:'Free answers for the Oxford Revise guide given out at school',b:'School guide',f:true},{n:'MME Revise',u:'https://mmerevise.co.uk',d:'Notes, recall questions and exam-style questions per topic - recommended by school',b:'Free',f:true},{n:'BBC Bitesize Science',u:'https://www.bbc.co.uk/bitesize/subjects/zgkw2hv',d:'Foundation-friendly topic guides with diagrams',b:'Free',f:true},{n:'Physics and Maths Tutor',u:'https://www.physicsandmathstutor.com/science-revision/combined-science-aqa',d:'AQA Combined Science past papers and revision notes',b:'Free',f:true}],
    youtube:[{n:'FreeScienceLessons',u:'https://www.youtube.com/@Freesciencelessons',d:'Full AQA Combined Science playlists - Biology, Chemistry and Physics'},{n:'Primrose Kitten',u:'https://www.youtube.com/@PrimroseKitten',d:'Whole of AQA videos - great for going through a full topic in one go'}],
    tiktoks:[{h:'@snaprevise',u:'https://www.tiktok.com/@snaprevise',d:'Science topic bite-sizes with strong visual explanations'},{h:'@draimee',u:'https://www.tiktok.com/@draimee',d:'Real science teacher - complex topics explained simply'},{h:'#gcsescience',u:'https://www.tiktok.com/tag/gcsescience',d:'Browse Combined Science revision shorts'}],
    tips:['Sparx Science first - Independent Learning tab, AQA GCSE, Biology 4.1-4.4, Chemistry 4.1-4.5, Physics 4.1-4.4.','Use the Oxford Revise guide from school: cover answers, test yourself, add wrong ones to flashcards.','Required practicals appear in every paper - know the method, variables and what the results show.','Foundation tier rewards clear precise answers. Use correct scientific words in every answer.','Biology Paper 1 = Cell Biology, Organisation, Infection and Response, Bioenergetics.']},
  spanish:{name:'Spanish',emoji:'&#127758;',board:'AQA',bg:'var(--span-bg)',t:'var(--span-t)',
    blurb:'Four skills: Reading, Listening, Speaking and Writing. Vocab is the foundation of all of them. Little and often is the best approach.',
    websites:[{n:'Seneca Learning',u:'https://app.senecalearning.com',d:'AQA Spanish vocabulary and grammar courses with recall testing',b:'Start here',f:true},{n:'BBC Bitesize Spanish',u:'https://www.bbc.co.uk/bitesize/subjects/zfckjxs',d:'Topic vocab, grammar guides and listening practice - fully free',b:'Free',f:true},{n:'Quizlet',u:'https://quizlet.com',d:'Make your own vocab flashcard sets - great for themes and verb tables',b:'Free',f:true},{n:'AQA Past Papers',u:'https://www.aqa.org.uk/subjects/languages/gcse/spanish-8698/assessment-resources',d:'Official AQA listening and reading past papers with mark schemes',b:'Official',f:true}],
    youtube:[{n:'Sr Jordan',u:'https://www.youtube.com/@SrJordan',d:'Clear grammar and vocabulary explanations for GCSE Spanish'},{n:'Profe en casa',u:'https://www.youtube.com/@ProfeEnCasa',d:'Spanish listening and comprehension practice'}],
    tiktoks:[{h:'@spanishwithalexandria',u:'https://www.tiktok.com/@spanishwithalexandria',d:'Quick grammar tips and vocab'},{h:'#gcseespanol',u:'https://www.tiktok.com/tag/gcseespanol',d:'GCSE Spanish revision shorts'},{h:'#spanishrevision',u:'https://www.tiktok.com/tag/spanishrevision',d:'Vocab, grammar and exam technique tips'}],
    tips:['For listening: do past papers under timed conditions - pause only when the paper says to.','Oral exam: prepare 10-12 flexible sentences you can use across different topics.','Learn tenses in order: present, preterite, future, conditional. Those four cover most marks.','Reading paper: work from context if you do not know a word. Never leave anything blank.','Learn vocab in themed groups like family, school, environment rather than random lists.']},
  pe:{name:'PE Theory',emoji:'&#127939;',board:'AQA',bg:'var(--pe-bg)',t:'var(--pe-t)',
    blurb:'The written exam covers anatomy, physiology and training principles. Flashcards work brilliantly for this subject.',
    websites:[{n:'Seneca Learning',u:'https://app.senecalearning.com',d:'AQA PE theory course - anatomy, training, health and fitness - free',b:'Start here',f:true},{n:'BBC Bitesize PE',u:'https://www.bbc.co.uk/bitesize/subjects/z97vrdm',d:'Clear revision guides for all PE theory topics - fully free',b:'Free',f:true},{n:'Physics and Maths Tutor PE',u:'https://www.physicsandmathstutor.com/pe-revision/gcse-aqa',d:'AQA PE past papers and topic notes',b:'Free',f:true},{n:'PE Revision YouTube',u:'https://www.youtube.com/@PERevision',d:'Short videos on muscles, joints, training methods and more',b:'Free',f:true}],
    youtube:[{n:'PE Revision Channel',u:'https://www.youtube.com/@PERevision',d:'Covers the AQA PE spec topic by topic'},{n:'Mr Mitchell PE',u:'https://www.youtube.com/@MrMitchellPE',d:'PE teacher explaining theory in plain and memorable terms'}],
    tiktoks:[{h:'#gcsepe',u:'https://www.tiktok.com/tag/gcsepe',d:'Quick anatomy and training method explainers'},{h:'#perevision',u:'https://www.tiktok.com/tag/perevision',d:'Short clips on key PE theory topics'}],
    tips:['Muscles: know major muscles by name AND their antagonist pairs - quads and hamstrings, biceps and triceps.','Learn all components of fitness with a definition AND a sport-specific example for each.','Training principles FITT, specificity, overload, reversibility often appear as 3-mark questions.','Use subject vocabulary. The heart beats faster gets 1 mark. Cardiac output increases gets 3 marks.','Flashcards are perfect for PE - key term on front, definition and sport example on back.']},
  business:{name:'Business and Enterprise BTEC',emoji:'&#128188;',board:'BTEC Level 2',bg:'var(--biz-bg)',t:'var(--biz-t)',
    blurb:'BTEC is coursework plus an external exam. For the exam units, knowing key terminology and applying it to case studies is everything.',
    websites:[{n:'Tutor2u Business',u:'https://www.tutor2u.net/business',d:'Excellent free topic guides, case studies and revision videos',b:'Start here',f:true},{n:'BBC Bitesize Business',u:'https://www.bbc.co.uk/bitesize/subjects/zpsvr82',d:'Covers enterprise, finance, marketing and operations clearly',b:'Free',f:true},{n:'Seneca Learning',u:'https://app.senecalearning.com',d:'Check for BTEC business courses - free tier',b:'Free',f:true},{n:'Tutor2u YouTube',u:'https://www.youtube.com/@tutor2ubusiness',d:'Video walkthroughs of key business topics',b:'Free',f:true}],
    youtube:[{n:'Tutor2u Business',u:'https://www.youtube.com/@tutor2ubusiness',d:'Topic walkthroughs specific to BTEC business units'},{n:'Two Teachers',u:'https://www.youtube.com/@twoteachers',d:'Business exam technique and topic explanations'}],
    tiktoks:[{h:'@tutor2u',u:'https://www.tiktok.com/@tutor2u',d:'Business and economics content in short form'},{h:'#gcsebusiness',u:'https://www.tiktok.com/tag/gcsebusiness',d:'Browse quick business theory explainers'},{h:'#btecbusiness',u:'https://www.tiktok.com/tag/btecbusiness',d:'BTEC-specific revision tips'}],
    tips:['Learn key definitions: entrepreneur, cash flow, break-even, marketing mix, stakeholders.','Always apply your answer to the case study given - generic answers rarely get full marks.','Cash flow vs profit - know the difference and why a profitable business can still fail.','For evaluate or justify questions, always give both sides before reaching a conclusion.','The 4Ps Product, Price, Place, Promotion come up constantly - know a real-world example for each.']}
};

function buildSubject(id){
  var s=subjects[id]; if(!s)return '';
  var bs='background:'+s.bg+';color:'+s.t+';';
  var h='<div class="subject-header" style="'+bs+'">';
  h+='<div style="font-size:2.5rem;margin-bottom:8px">'+s.emoji+'</div>';
  h+='<h2>'+s.name+'</h2><div class="board-tag">'+s.board+'</div><p>'+s.blurb+'</p></div>';
  h+='<div class="resource-section"><h3>&#127760; Websites and revision tools</h3><div class="link-cards">';
  for(var i=0;i<s.websites.length;i++){
    var r=s.websites[i];
    h+='<a class="link-card" href="'+r.u+'" target="_blank">';
    h+='<span class="lc-badge" style="'+bs+'">'+r.b+'</span>';
    h+='<div class="lc-name">'+r.n+'</div>';
    h+='<div class="lc-desc">'+r.d+'</div>';
    h+='<span class="free-note">'+(r.f?'&#10003; Free to use':'Check school access')+'</span></a>';
  }
  h+='</div></div>';
  h+='<div class="resource-section"><h3>&#9654;&#65039; YouTube channels</h3><div class="link-cards">';
  for(var i=0;i<s.youtube.length;i++){
    var r=s.youtube[i];
    h+='<a class="link-card" href="'+r.u+'" target="_blank">';
    h+='<div class="lc-name">'+r.n+'</div>';
    h+='<div class="lc-desc">'+r.d+'</div>';
    h+='<span class="free-note">&#10003; Free to use</span></a>';
  }
  h+='</div></div>';
  h+='<div class="resource-section"><h3>&#128241; TikTok accounts and hashtags</h3><div class="tiktok-row">';
  for(var i=0;i<s.tiktoks.length;i++) h+='<a class="tt-chip" href="'+s.tiktoks[i].u+'" target="_blank"><div class="tt-icon"></div>'+s.tiktoks[i].h+'</a>';
  h+='</div><div class="tt-desc-row" style="margin-top:8px">';
  for(var i=0;i<s.tiktoks.length;i++){if(i>0)h+=' &middot; ';h+='<strong>'+s.tiktoks[i].h+'</strong> - '+s.tiktoks[i].d;}
  h+='</div></div>';
  h+='<div class="resource-section"><h3>&#128161; Top tips for this subject</h3><div class="tips-grid">';
  for(var i=0;i<s.tips.length;i++) h+='<div class="tip-card" data-n="'+(i+1)+'">'+s.tips[i]+'</div>';
  h+='</div></div>';
  return h;
}


